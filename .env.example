# Шаблон окружения book-shelf. Порядок работы:
#
#   cp .env.example .env
#
# и заполните как минимум BOT_TOKEN. Файл .env в git не попадает, секреты
# подставляются в контейнеры через docker compose и в образы не запекаются.

# ── обязательные ────────────────────────────────────────────
# Токен Telegram-бота от @BotFather. Пустое значение — бот не стартует:
# в логах будет «missing required environment variables: BOT_TOKEN».
BOT_TOKEN=

# ── пути на хосте (bind-источники) ───────────────────────────
# Каталог с *.zip-архивами. Создайте его вручную: docker иначе создаст пустой
# каталог от root, и оператор этого не заметит (см. README, «Диагностика»).
# scan монтирует этот каталог на запись и создаёт рядом *.zip.json.
LIBRARY_HOST_DIR=./data/library
# Каталог под базу SQLite. Монтируется каталогом, а не файлом: SQLite требует
# соседних -wal/-shm, а bind-mount отсутствующего файла создаёт каталог.
# Размещайте на локальной ФС (ext4/xfs), не на NFS/SMB.
DATA_HOST_DIR=./data/db

# ── пути в контейнере ───────────────────────────────────────
LIBRARY_CONTAINER_DIR=/library
DATA_CONTAINER_DIR=/data
# Имя файла базы внутри DATA_CONTAINER_DIR.
DB_FILE=db.sqlite3

# ── приложение ──────────────────────────────────────────────
# Одновременная обработка архивов в scan. Нечисловое значение игнорируется.
SCAN_PARALLELISM=5
# Прокси к api.telegram.org. Пусто — прямое соединение.
# В контейнер попадает ТОЛЬКО это значение: HTTP_PROXY, экспортированный в
# shell хоста, больше не подхватывается.
HTTP_PROXY=
# uid:gid контейнера scan, которому нужны права на запись в каталог библиотеки.
# Должен совпадать с владельцем LIBRARY_HOST_DIR на хосте (см. README, шаг chown).
SCAN_USER_ID=10001
SCAN_GID=10001
# uid:gid контейнера db-create: он пишет в DATA_HOST_DIR.
APP_USER_ID=10001
APP_GID=10001

# ── логирование ─────────────────────────────────────────────
# debug|info|warn|error
LOG_LEVEL=info
# json|text
LOG_FORMAT=json
# Часовой пояс меток времени в логах.
TZ=UTC

# ── compose ─────────────────────────────────────────────────
# Префикс имён контейнеров, сети и томов.
COMPOSE_PROJECT_NAME=book-shelf

# ── DSN (обычно не нужно) ────────────────────────────────────
# По умолчанию compose вычисляет DB_DSN как ${DATA_CONTAINER_DIR}/${DB_FILE},
# то есть /data/db.sqlite3. Раскомментируйте строку, только если нужно
# добавить параметры DSN, например:
#   WAL      — снимает «database is locked», когда бот читает базу, а db-create пишет;
#   busy_timeout — сколько миллисекунд ждать блокировки (по умолчанию 5000).
# DB_DSN=/data/db.sqlite3?_journal_mode=WAL&_busy_timeout=5000